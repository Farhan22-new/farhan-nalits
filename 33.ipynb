   "source": [
    "n = int (input(\"Enter a number:\"))\n",
    "\n",
    "factorial = 1\n",
    "\n",
    "for i in range(n,0,-1):\n",
    "    factorial = factorial * i\n",
    "\n",
    "print(\"Factorial:\", factorial)"
