     "text": [
      "2000 is a leap year\n"
     ]
    }
   ],
   "source": [
    "year = 2000\n",
    "\n",
    "if year % 400 == 0:\n",
    "    print(year, \"is a leap year\")\n",
    "\n",
    "elif year % 100 == 0:\n",
    "    print(year, \"is not a leap year\")\n",
    "\n",
    "elif year % 4 == 0:\n",
    "    print(year, \"is a leap year\")\n",
    "\n",
    "else:\n",
    "    print(year, \"is not a leap year\")\n"
   ]
  }
