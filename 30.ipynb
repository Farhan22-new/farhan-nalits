   ],
   "source": [
    "a = int(input(\"Enter first side: \"))\n",
    "b = int(input(\"Enter second side: \"))\n",
    "c = int(input(\"Enter third side: \"))\n",
    "\n",
    "if a == b and b == c:\n",
    "    print(\"Equilateral triangle\")\n",
    "\n",
    "elif a == b or a == c or b == c:\n",
    "    print(\"Isosceles triangle\")\n",
    "\n",
    "else:\n",
    "    print(\"Scalene triangle\")"
   ]
  }
 ],
